{
  "name": "the-explorers-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node tests/run.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "dev": "node scripts/secure-server.mjs",
    "start": "node scripts/secure-server.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "data:prepare": "python scripts/prepare-ar.py",
    "start:lan": "node scripts/secure-server.mjs",
    "build": "node scripts/build.mjs",
    "test:workers": "node tests/terrain-worker.test.mjs",
    "test:security": "python tests/security-smoke.py"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.4.0",
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/node": "22.19.19",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.0",
    "linkedom": "^0.18.15",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "wrangler": "^4.162.0"
  }
}
